# Copy to .env.local at the repo root and fill in. Never commit .env.local.
# Any integration whose keys are blank runs in mock mode (see ANTIBODY_MOCK).

# --- Antibody ---
ANTIBODY_WEB_URL=http://localhost:3000
# Where the web app reaches the orchestrator. Deployed: the Chalk scaling group's HTTPS URL, set in Vercel project env
# (Production and Preview). The orchestrator runs on Chalk, not Vercel: it has to stay up to read texts and run Droid.
ANTIBODY_ORCHESTRATOR_URL=http://localhost:3001
# Shared secret the web app sends to the orchestrator. Optional locally; the orchestrator refuses to
# listen publicly (PORT set) without it. Set the same value on Vercel and in the Chalk secret.
ANTIBODY_ORCHESTRATOR_TOKEN=
# Relative paths resolve from the repo root, so every app shares one store.
ANTIBODY_DATA_DIR=data
# Optional: shared store in Supabase, needed when web and orchestrator run on different hosts (Vercel + Chalk).
# Blank = data/db.json. Table setup SQL is at the top of packages/core/src/store.ts. Server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only these hosts may be actively probed by scans and attack scripts (our own apps).
# 4000 = sample app unprotected, 4001 = same app behind the shield, 4020 = Guestlist sample.
ANTIBODY_VERIFIED_DOMAINS=localhost:4000,localhost:4001,localhost:4020
# Source folder per verified host, audited with Semgrep (install: uv tool install semgrep).
ANTIBODY_REPOS=localhost:4000=samples/vuln-app,localhost:4001=samples/vuln-app,localhost:4020=samples/guestlist
# auto = mock any integration with missing keys; off = fail loudly instead; on = mock everything (no real texts/calls)
ANTIBODY_MOCK=auto
# Optional: ms before an unanswered critical alert becomes a phone call (default 5 minutes). 20000 for testing.
ANTIBODY_CALL_AFTER_MS=

# --- Photon 2.0 beta (https://app.beta.photon.codes) ---
# Key needs project:read + project:write (add platforms:read for voice profile reads)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PLATFORM=imessage
# Shared-pool iMessage number assigned to the agent
PHOTON_AGENT_HANDLE=
# Your phone in E.164 (e.g. +16175550123) or iMessage email
PHOTON_TEST_SENDER=
# SMS number with a Voice profile (needed for calls; buy only after confirming cost)
PHOTON_VOICE_NUMBER=

# --- ElevenLabs (voice agent behind Photon SIP) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Imported Photon number on the ElevenLabs Phone Numbers page (starts phnum_)
ELEVENLABS_PHONE_NUMBER_ID=

# --- Chalk (project cmvbxnw2o00j6010n3lqfczrl) ---
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=nynmb961fd0e
CHALK_API_SERVER=https://api.chalk.ai

# --- Sign in with GitHub (the Antibody GitHub App's OAuth client; blank locally = mock sign-in) ---
# Client ID is on the app's settings page; generate the secret there too. Callback URL: <ANTIBODY_WEB_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session cookie. Required when deployed; any long random string (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
ANTIBODY_SESSION_SECRET=

# --- Connect Vercel (the Antibody Vercel Integration; blank = mock, nothing imported) ---
# Integration Console: Redirect URL <ANTIBODY_WEB_URL>/api/vercel/callback, API scopes Projects: Read.
# Not VERCEL_*: Vercel reserves that prefix for its own system variables.
ANTIBODY_VERCEL_INTEGRATION_SLUG=
ANTIBODY_VERCEL_CLIENT_ID=
ANTIBODY_VERCEL_CLIENT_SECRET=

# --- xAI / Grok (repo review; blank = pattern checks only, no model call) ---
XAI_API_KEY=
# Optional. Defaults to grok-4.7.
XAI_MODEL=

# --- Factory / Droid SDK (blank = mock fixer) ---
FACTORY_API_KEY=
# Windows only (after `npm i -g droid`): the native binary, e.g.
# C:\Users\<you>\AppData\Roaming\npm\node_modules\droid\node_modules\@factory\cli-win32-x64\bin\droid.exe
DROID_EXEC_PATH=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
