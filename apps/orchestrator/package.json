    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@antibody/core": "^0.0.0",
    "@antibody/scanner": "*",
    "@factory/droid-sdk": "^0.9.1",
    "@photon-ai/api": "^0.5.0"
  }
}
