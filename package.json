{
  "name": "antibody",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "samples/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w @antibody/web",
    "dev:orchestrator": "npm run dev -w @antibody/orchestrator",
    "dev:sample": "npm run dev -w @antibody/vuln-app",
    "dev:guestlist": "npm run dev -w @antibody/guestlist",
    "dev:shielded": "npm run dev:protected -w @antibody/vuln-app",
    "dev:all": "node scripts/dev-all.mjs",
    "eval": "node --import tsx evals/run.ts",
    "attack": "node --import tsx attacks/all.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p evals",
    "test": "npm run test --workspaces --if-present && vitest run --root evals",
    "droid:check": "node --env-file-if-exists=.env.local scripts/droid-check.mjs"
  }
}
