{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "orchestrator",
          "format": "url",
          "env": "ANTIBODY_ORCHESTRATOR_URL"
        }
      ]
    },
    "orchestrator": {
      "root": "apps/orchestrator",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
